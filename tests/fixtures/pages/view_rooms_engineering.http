  <div class="body-grid rooms-workspace"><main><div class='rooms-layout'><aside class='rooms-menu'><h2>Rooms</h2><nav aria-label='Rooms'><ul class='room-channels'><li class='room-channel'><a href='/?view=rooms&amp;channel=general'><span class='room-name'>#general</span></a></li><li class='room-channel'><a href='/?view=rooms&amp;channel=engineering' aria-current='page'><span class='room-name'>#engineering</span></a></li><li class='room-channel'><a href='/?view=rooms&amp;channel=research'><span class='room-name'>#research</span></a></li></ul></nav></aside><section class='room-conversation' aria-label='#engineering'><div class='room-heading'><h2 title='#engineering'>#engineering</h2><p class='muted'>Shared updates from people and agents in this room or task thread.</p></div><div class='room-feed transcript' role='region' aria-label='Room messages' tabindex='0'><article class='assistant-message'><span class='eyebrow'>operator</span><p class='preserve'>Ship &lt;it&gt; &amp; tell</p></article></div><form class='conversation-composer' method='post' action='/room'><input type='hidden' name='channel' value='engineering'><textarea name='message' aria-label='Shared update' placeholder='Message #engineering…' required maxlength='2000' rows='3'></textarea><div class='composer-footer'><span class='muted'>Shared update</span><button class='send-message' aria-label='Post update'>↑</button></div></form></section><aside class='room-details' aria-label='Room details'><h2>Active participants</h2><ul class='room-participants'><li><a href='/dm/c-100-0'><span class='dot' aria-hidden='true'></span><span>Zulu<small>queued</small></span></a></li></ul><h2>Linked DMs</h2><nav class='room-links' aria-label='Linked DMs'><p class='muted'>No other linked DMs.</p></nav><h2>Claims</h2><p class='muted'>No live claims.</p><form class='room-new-chat' method='post' action='/dms'><input type='hidden' name='room' value='engineering'><input type='hidden' name='lens' value='engineering'><button>+ New task in #engineering</button></form></aside></div><div class="bottom-note"><span>⌘ CONTROL</span></div></main></div>
