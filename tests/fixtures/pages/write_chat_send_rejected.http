</aside>
<div class="shell">
  <header><div class="header-left"><a class="new-chat-link" href="/dms?new=1"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>New DM</a><span class="header-context"></span></div><div class="header-right"><a class="node-link" href="/?view=nodes"><span class="node-indicator" aria-hidden="true"></span>Local</a></div></header>
  <div class="body-grid chat-workspace"><main><section class='conversation'><div class='conversation-heading'><details class='conversation-toggle'><summary aria-label='DMs' title='DMs'>☰ <span>DMs</span></summary><aside class='section-navigation conversation-navigation'><h2>DMs</h2><nav aria-label='DMs'><a href='/dms?new=1'>+ New DM</a><a class='conversation-link' href='/dm/c-100-2' title='Hotel' data-conversation-depth='0' aria-current='page'><span class='conversation-title'>Hotel</span></a><details class='conversation-branch' data-chat-branch='c-100-0'><summary data-conversation-depth='0'><a class='conversation-link' href='/dm/c-100-0' title='Zulu' data-conversation-depth='0'><span class='conversation-title'>Zulu</span></a></summary><div class='conversation-children'><a class='conversation-link' href='/dm/c-100-1' title='Olive' data-conversation-depth='1'><span class='conversation-title'>Olive</span></a></div></details></nav></aside></details><h2>Hotel</h2><span class='conversation-links'><a href='/dm/c-100-2/memory'>Memory Tree ↗</a><a href='/dm/c-100-2/artifacts'>Artifacts ↗</a></span><details class='chat-requests'><summary>Requests <span class='request-count' aria-live='polite'></span></summary><aside class='request-drawer' aria-label='Pending requests'><iframe class='chat-requests-frame' data-live-chat src='/dm/c-100-2/requests' title='Pending requests'></iframe></aside></details></div><div class='conversation-main'><iframe class='chat-transcript' data-live-chat src='/dm/c-100-2/transcript#latest' title='Conversation'></iframe><p class='muted' role='alert'>Use /steer followed by a direction for the next turn.</p><form class='conversation-composer' id='session-message' method='post' action='/dm/c-100-2/messages'><textarea name='message' required rows='3' aria-label='Message' placeholder='Message Control…'>/steer</textarea><div class='chat-commands' id='chat-commands' role='listbox' aria-label='Chat commands' hidden><button type='button' role='option' id='command-improve' data-command='/improve' aria-selected='false'><span>/improve</span><small>Discuss and change Control</small></button><button type='button' role='option' id='command-improve-off' data-command='/improve off' aria-selected='false'><span>/improve off</span><small>Return to regular chat</small></button><button type='button' role='option' id='command-steer' data-command='/steer' aria-selected='false'><span>/steer</span><small>Queue a direction for the next turn</small></button><button type='button' role='option' id='command-btw' data-command='/btw' aria-selected='false'><span>/btw</span><small>Ask in a separate conversation</small></button><button type='button' role='option' id='command-spawn' data-command='/spawn' aria-selected='false'><span>/spawn</span><small>Start an independent agent</small></button><button type='button' role='option' id='command-cancel' data-command='/cancel' aria-selected='false'><span>/cancel</span><small>Stop the current run</small></button><button type='button' role='option' id='command-answer' data-command='/answer' aria-selected='false'><span>/answer</span><small>Answer a design question</small></button><button type='button' role='option' id='command-open' data-command='/open' aria-selected='false'><span>/open</span><small>Open a folder on this node</small></button><button type='button' role='option' id='command-listen' data-command='/listen' aria-selected='false'><span>/listen</span><small>Listen for room messages</small></button><button type='button' role='option' id='command-listen-off' data-command='/listen off' aria-selected='false'><span>/listen off</span><small>Stop room listening</small></button><button type='button' role='option' id='command-bot' data-command='/bot on' aria-selected='false'><span>/bot on</span><small>Run this DM as a persistent bot</small></button><button type='button' role='option' id='command-bot-off' data-command='/bot off' aria-selected='false'><span>/bot off</span><small>Stop this DM's bot</small></button><button type='button' role='option' id='command-room' data-command='/room general' aria-selected='false'><span>/room general</span><small>Attach this DM to a room</small></button><button type='button' role='option' id='command-room-off' data-command='/room off' aria-selected='false'><span>/room off</span><small>Detach this DM from its room</small></button><button type='button' role='option' id='command-cancel-all' data-command='/cancel all' aria-selected='false'><span>/cancel all</span><small>Stop runs and bots in this DM and every DM it spawned</small></button><button type='button' role='option' id='command-model' data-command='/model' aria-selected='false'><span>/model</span><small>List or select this DM's model</small></button><button type='button' role='option' id='command-rename' data-command='/rename' aria-selected='false'><span>/rename</span><small>Rename this DM</small></button><button type='button' role='option' id='command-memory' data-command='/memory' aria-selected='false'><span>/memory</span><small>Show this DM's Memory Tree status (alias /compact)</small></button><button type='button' role='option' id='command-memory-on' data-command='/memory on' aria-selected='false'><span>/memory on</span><small>Opt this DM into the Memory Tree (operator)</small></button><button type='button' role='option' id='command-memory-off' data-command='/memory off' aria-selected='false'><span>/memory off</span><small>Opt this DM out of the Memory Tree (operator)</small></button><button type='button' role='option' id='command-services' data-command='/services' aria-selected='false'><span>/services</span><small>List the running services of this DM and its team</small></button><button type='button' role='option' id='command-services-stop' data-command='/services stop' aria-selected='false'><span>/services stop</span><small>Stop a service by ID (or all); /workspace is kept</small></button></div><div class='composer-footer'><input type='hidden' name='composition' value='1' form='session-message'><div class='chat-tags'><details class='lens-selector'><summary>+ Genes</summary></details><div class='tag-options'><label class='lens-option lens-tag'><input type='checkbox' name='lens_acceptance' value='acceptance' form='session-message'><span>Acceptance check</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_advisor' value='advisor' form='session-message'><span>Team advisor</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_antibody' value='antibody' form='session-message'><span>Antibodies</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_architecture-notes' value='architecture-notes' form='session-message'><span>Architecture notes</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_autonomy' value='autonomy' form='session-message'><span>Task autonomy</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_context-inspector' value='context-inspector' form='session-message'><span>Context inspector</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_coordination' value='coordination' form='session-message'><span>Coordination &amp; planning</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_engineering' value='engineering' form='session-message'><span>Engineering</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_evidence' value='evidence' form='session-message'><span>Evidence</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_ganglia' value='ganglia' form='session-message'><span>Ganglia</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_gene-0000' value='gene-0000' form='session-message'><span>Gene 0: castle &lt;&amp;&gt; relay</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_gene-0001' value='gene-0001' form='session-message'><span>Gene 1: castle &lt;&amp;&gt; relay</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_gene-0002' value='gene-0002' form='session-message'><span>Gene 2: castle &lt;&amp;&gt; relay</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_investigation' value='investigation' form='session-message'><span>Bounded investigation</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_monitor' value='monitor' form='session-message'><span>Team monitor</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_planning' value='planning' form='session-message'><span>Planning procedure</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_repository-edit' value='repository-edit' form='session-message'><span>Repository edit</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_repository-read' value='repository-read' form='session-message'><span>Repository read</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_research' value='research' form='session-message'><span>Research</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_source-search' value='source-search' form='session-message'><span>Source search</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_swarm' value='swarm' form='session-message'><span>Swarm</span></label><label class='lens-option lens-tag'><input type='checkbox' name='lens_timers' value='timers' form='session-message'><span>Timers</span></label></div><a class='lens-library-shortcut' href='/dna' aria-label='Open DNA library'>↗</a></div><button class='send-message' aria-label='Send message'>↑</button></div></form></div></section><div class="bottom-note"><span>⌘ CONTROL</span></div></main></div>
