<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.control.web</string>
  <key>ProgramArguments</key><array><string>@CONTROL_BINARY@</string></array>
  <key>WorkingDirectory</key><string>@CONTROL_STATE_DIR@</string>
  <key>EnvironmentVariables</key><dict><key>CONTROL_ADDR</key><string>127.0.0.1:8080</string><key>CONTROL_CONFIG_DIR</key><string>@CONTROL_CONFIG_DIR@</string><key>CONTROL_STATE_DIR</key><string>@CONTROL_STATE_DIR@</string><key>PATH</key><string>@CONTROL_HOME@/.nix-profile/bin:/etc/profiles/per-user/@CONTROL_USER@/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:@CONTROL_HOME@/.orbstack/bin:@CONTROL_HOME@/.docker/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>60</integer>
  <key>StandardOutPath</key><string>@CONTROL_STATE_DIR@/web.log</string>
  <key>StandardErrorPath</key><string>@CONTROL_STATE_DIR@/web-error.log</string>
</dict></plist>
